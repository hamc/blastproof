{
  "name": "blastproof",
  "version": "0.0.1",
  "description": "Open-source AI testing agent for pull requests. Diff in, confidence out.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "blastproof": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "testing",
    "e2e",
    "pull-request",
    "qa",
    "playwright",
    "llm",
    "agent"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}
