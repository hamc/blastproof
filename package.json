{
  "name": "blastproof",
  "version": "0.0.1",
  "description": "Open-source AI testing agent for pull requests. Diff in, confidence out.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "blastproof": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "testing",
    "e2e",
    "pull-request",
    "qa",
    "playwright",
    "llm",
    "agent"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/openai": "^4.0.20",
    "ai": "^7.0.37",
    "commander": "^15.0.0",
    "picomatch": "^4.0.5",
    "playwright": "^1.62.0",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "@types/yaml": "^1.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
